# --- Required -------------------------------------------------------------
DOMAIN=podcasts.example.com
PUBLIC_URL=https://podcasts.example.com
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (must decode to exactly 32 bytes)
ENCRYPTION_KEY=

# --- Search (free key: https://api.podcastindex.org) ----------------------
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# --- Patreon (https://www.patreon.com/portal/registration/register-clients)
# Redirect URI to declare on Patreon: ${PUBLIC_URL}/patreon/oauth/callback
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# --- Push notifications (Firebase > Project settings > Service accounts) --
# Paste the JSON on one line, or mount the file and use FCM_SERVICE_ACCOUNT_FILE.
FCM_SERVICE_ACCOUNT_JSON=

# --- Optional -------------------------------------------------------------
ALLOW_REGISTRATION=true
REFRESH_INTERVAL_MINUTES=20
