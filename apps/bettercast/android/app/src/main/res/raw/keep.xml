<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service looks these icons up by name (media notification,
     Android Auto custom actions). Without this, release resource
     shrinking drops them and every media session update crashes. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_replay_15,@drawable/ic_forward_30,@drawable/ic_speed,@drawable/ic_stat_bettercast" />
